# Copy this file to .env (in the project root) and fill in your own values.
# .env is ignored by Git. Never commit real keys or passwords.

# MongoDB Atlas connection string (each service uses its own database on it)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: a Groq model that accepts images (for receipt scanning)
GROQ_MODEL=qwen/qwen3.8-27b
